# Cloud MySQL (Aiven) connection
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-port
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=dms
DB_SSL=true

# License signing key — use ONE of these two, not both. NEVER commit the
# actual private key to git, and never ship it inside the desktop app.
#
# Local dev: path to the file generated by scripts/generate-keys.js
LICENSE_PRIVATE_KEY_PATH=./keys/private.pem
#
# Render / Railway (no file paths available there): paste the PEM content
# directly into that platform's environment variables dashboard instead, e.g.
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

PORT=4000
